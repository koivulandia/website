---
import "../styles/global.css";

import { Image } from "astro:assets";
import logoNoText from "../images/logo-no-text.png";

import { Icon } from "astro-icon/components";

const currentYear = new Date().getFullYear();
---

<html lang="fi">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Koivulandia</title>
    </head>
    <body class="bg-zinc-800 text-white">
        <header class="sticky top-0 backdrop-blur-md flex justify-between">
            <div class="flex items-center">
                <a href="/" class="p-2 flex items-center gap-2 text-lime-500 font-bold text-2xl">
                    <Image
                        src={logoNoText}
                        alt="Koivulandian logo"
                        class="w-12 rounded-full"
                    />
                    Koivulandia
                </a>
                <nav class="p-4 flex gap-4">
                    <a href="/faq" class="font-bold hover:text-lime-500">FAQ</a>
                    <a href="/legislations" class="font-bold hover:text-lime-500">Lakitekstit</a>
                    <a href="/literature" class="font-bold hover:text-lime-500">Kirjallisuus</a>
                    <a href="/roles" class="font-bold hover:text-lime-500">Roolit</a>
                </nav>
            </div>
            <nav class="p-4 flex items-center gap-4">
                <a><Icon class="text-3xl hover:text-lime-500" name="fa7-brands:discord" /></a>
                <a><Icon class="text-3xl hover:text-lime-500" name="fa7-brands:instagram" /></a>
                <a><Icon class="text-3xl hover:text-lime-500" name="fa7-brands:youtube" /></a>
                <a><Icon class="text-3xl hover:text-lime-500" name="fa7-brands:twitch" /></a>
            </nav>
        </header>
        <main>
            <slot />
        </main>
        <footer class="bg-zinc-900 px-4 py-16 text-center">
            <a href="mailto:koivusahko88@gmail.com" class="text-lime-500">koivusahko88@gmail.com</a>
            <p class="text-zinc-400">&copy; {currentYear} Koivulandia</p>
        </footer>
    </body>
</html>
