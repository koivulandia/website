---
import "../styles/global.css";

import Navbar from "../components/Navbar.astro";

import Link from "../components/typography/Link.astro"
import Paragraph from "../components/typography/Paragraph.astro";

const currentYear = new Date().getFullYear();
---

<html lang="fi">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
        <link rel="manifest" href="/site.webmanifest">

        <title>Koivulandia</title>
    </head>
    <body class="bg-zinc-800 text-white">
        <Navbar />
        <slot />
        <footer class="bg-zinc-900 px-4 py-16 text-center">
            <Link href="mailto:koivusahko88@gmail.com">koivusahko88@gmail.com</Link>
            <Paragraph>&copy; {currentYear} Koivulandia</Paragraph>
        </footer>
    </body>
</html>
