---
import "../styles/global.css";
import { Image } from "astro:assets";
import logoNoText from "../images/logo-no-text.png";
---

<html lang="fi">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Koivulandia</title>
    </head>
    <body class="bg-zinc-800 text-white">
        <header class="bg-zinc-700 flex justify-between">
            <div class="flex items-center">
                <a href="/" class="p-2 flex gap-2 items-center text-lime-500 font-bold text-2xl">
                    <Image
                        src={logoNoText}
                        alt="Koivulandian logo"
                        class="w-12 rounded-full"
                    />
                    Koivulandia
                </a>
                <nav class="p-4 flex gap-4">
                    <a href="/faq" class="font-bold hover:text-lime-500">FAQ</a>
                    <a href="/laws" class="font-bold hover:text-lime-500">Lakitekstit</a>
                </nav>
            </div>
            <nav class="p-4 flex items-center gap-4">
                <a class="font-bold hover:text-lime-500">Discord</a>
            </nav>
        </header>
        <main class="p-4">
            <slot />
        </main>
        <footer></footer>
    </body>
</html>
