---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Banner from "../components/Banner.astro";
import Button from "../components/Button.astro";

import { Image } from "astro:assets";
import jussi from "../images/jussi88takanasi-head.png";
---
<BaseLayout>
	<Banner />
	<Section>
		<h1 class="text-4xl font-bold mb-4">Fabicraft</h1>
		<p>Moi. Tähän tulis teksti, että Koivulandia toimii FabiCraftissa. Ja kanssa vähän et millainen FabiCraft on.</p>
		<Button href="https://fabicraft.net" target="_blank">Pelipalvelimelle</Button>
	</Section>
	<Section>
		<h1 class="text-4xl font-bold mb-4">No Jussi :)</h1>
		<Image src={jussi} alt="Jussin iso pää" class="w-full h-32" />
	</Section>
</BaseLayout>
