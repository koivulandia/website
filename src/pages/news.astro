---
import BaseLayout from "../layouts/BaseLayout.astro";

import Section from "../components/layout/Section.astro";
import Container from "../components/layout/Container.astro";

import Heading from "../components/typography/Heading.astro";
import FormattedDate from "../components/FormattedDate.astro";

import { getCollection, render } from "astro:content";

const collection = await getCollection("news");
const sorted = collection.sort((a, b) => b.id.localeCompare(a.id));

const news = await Promise.all(
  sorted.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  }))
);
---
<BaseLayout>
    <Section class="pt-32">
        <Container>
            <div class="grid gap-16">
              {
                news.map(({ entry, Content }) => (
                  <article>
                      <Heading>{entry.data.title}</Heading>
                      <p class="text-zinc-500 mb-2"><FormattedDate date={entry.id} /></p>
                      <div class="prose prose-invert prose-zinc max-w-none prose-a:text-lime-500 prose-a:no-underline prose-a:hover:text-lime-600">
                          <Content />
                      </div>
                  </article>
                ))
              }
            </div>
        </Container>
    </Section>
</BaseLayout>
