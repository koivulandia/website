---
import BaseLayout from "../../layouts/BaseLayout.astro";

import Section from "../../components/layout/Section.astro";
import Container from "../../components/layout/Container.astro";

import Heading from "../../components/typography/Heading.astro";
import Paragraph from "../../components/typography/Paragraph.astro";

import Panel from "../../components/Panel.astro";

import { getCollection } from "astro:content";

const literatures = (await getCollection("literature")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout>
	<Section class="pt-32">
		<Container>
			<Heading class="mb-4">Kirjallisuus</Heading>
			<div class="flex flex-col gap-4">
				{literatures.map(literature => (
					<Panel href={`/literature/${literature.id}/`}>
						<Heading size={2}>{literature.data.title}</Heading>
					</Panel>
				))}
			</div>
		</Container>
	</Section>
</BaseLayout>
