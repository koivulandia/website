---
import BaseLayout from "../layouts/BaseLayout.astro";

import Section from "../components/layout/Section.astro";
import Container from "../components/layout/Container.astro";

import Heading from "../components/typography/Heading.astro";
import Paragraph from "../components/typography/Paragraph.astro";

import Panel from "../components/Panel.astro";
import PlayerHead from "../components/minecraft/PlayerHead.astro";
import MinecraftUsername from "../components/minecraft/MinecraftUsername.astro";

import roles from "../data/roles.json";
---

<BaseLayout>
	<Section class="pt-32">
		<Container>
			<Heading class="mb-4">Yleisimmät roolit</Heading>
			<div class="flex flex-col gap-16">
				{Object.entries(roles).map(([category, roleList]) => (
				<div>
					<Heading size={2}>{category}</Heading>
					<div class="flex flex-col gap-4">
						{roleList.map(role => (
						<Panel borderColor={role.color}>
							<Heading size={3}>{role.role}</Heading>
							<Paragraph>{role.description}</Paragraph>
							<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
								{role.members.map(member => (
									<div class="flex">
										<PlayerHead uuid={member.minecraftIdentifier} class="w-16 h-16" />
										<div class="flex flex-col pl-2">
											<Heading class="mb-0!" size={4}><MinecraftUsername uuid={member.minecraftIdentifier} /></Heading>
											<Paragraph>{member.discordUsername}</Paragraph>
										</div>
									</div>
								))}
							</div>
						</Panel>
					))}
					</div>
				</div>
			))}
			</div>
		</Container>
	</Section>
</BaseLayout>
