---
import BaseLayout from "../layouts/BaseLayout.astro";

import Section from "../components/layout/Section.astro";
import Container from "../components/layout/Container.astro";

import Code from "../components/typography/Code.astro"
import Heading from "../components/typography/Heading.astro";
import Link from "../components/typography/Link.astro";
import Paragraph from "../components/typography/Paragraph.astro";

import Panel from "../components/Panel.astro";
---

<BaseLayout>
	<Section class="pt-32">
		<Container>
			<Heading class="mb-4">Usein kysytyt kysymykset</Heading>
			<div class="flex flex-col gap-4">
				<Panel>
					<Heading size={3}>Mikä ihmeen Koivulandia?</Heading>
					<Paragraph>
						Koivulandia on Minecraft-valtio <Link href="fabicraft.net" target="_blank">fabicraft.net</Link>-nimisellä palvelimella
					</Paragraph>
				</Panel>
				<Panel>
					<Heading size={3}>Kuinka liittyä Koivulandiaan?</Heading>
					<Paragraph>
						Koivulandiaan voit liittyä Minecraftista.
						Mene <Link href="fabicraft.net" target="_blank">FabiCraftin</Link> nettisivuille, josta löydät ohjeet liittymiseen palvelimelle.
					</Paragraph>
					<Paragraph>
						Muuttamiseen voit kysyä apua <Link href="https://discord.gg/44dPAyUT8u" target="_blank">Koivulandian Discordista</Link> tai paikalla olevilta pelaajilta
					</Paragraph>
				</Panel>
				<Panel>
					<Heading size={3}>Miten löydän Koivulandian palvelimelta?</Heading>
					<Paragraph>
						Koivulandia sijaitsee survivalissa. Helpoin tapa on tulla Koivulandiaan komennolla <Code>/warp koivu-keskusta</Code>.
						Komento <Code>/warp koivulandia</Code> vie Koivulandian suurimmalle asutusalueelle Koivulahteen. Koivulandian koordinaatit ovat x: -2000, z: 900
					</Paragraph>
				</Panel>
				<Panel>
					<Heading size={3}>Miten saan rooleja sekä virkoja Koivulandiasta?</Heading>
					<Paragraph>
						Rooleja ja virkoja saa lähtökohtaisesti silloin, kun tekee Koivulandian eteen töitä. Esimerkiksi rakentajaksi ja kansalaisavustajaksi eli kavaksi on mahdollista päästä.
						Yleensä paras tapa on ilmaista kiinnostustaan Discordissa tai ottamalla suoraan yhteyttä suoraan esihenkilöihin - he auttavat mielellään!
					</Paragraph>
				</Panel>
				<Panel>
					<Heading size={3}>Mistä löydän tietoa Koivulandiasta?</Heading>
					<Paragraph>
						Koivulandissa on monia <Link href="/legislations">lakeja</Link>, jotka antavat paljon tietoa Koivulandian toiminnasta. Koivulandian historiasta on kirjoitettu suuremmoinen teos, yli 600 -sivuinen Koivulandian Historia.
						Mikäli haluat tietää jotakin lisää, voit esimerkiksi kysellä Discordissa kysymyskanavalla lisää - joku varmasti kertoo lisää tietoa!
					</Paragraph>
				</Panel>
				<Panel>
					<Heading size={3}>Milloin Koivulandia kokoontuu?</Heading>
					<Paragraph>
						Silloin, kun on jotain tärkeää päätettävää ja juteltavaa. Näistä ilmoitetaan yleensä etukäteen :)
					</Paragraph>
				</Panel>
			</div>
		</Container>
	</Section>
</BaseLayout>
