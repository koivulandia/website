---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Panel from "../components/Panel.astro";
---

<BaseLayout>
	<Section class="pt-32">
		<h1 class="text-4xl font-bold mb-4">Usein kysytyt kysymykset</h1>
		<div class="flex flex-col gap-4">
			<Panel>
				<h2 class="text-xl font-bold">Mikä ihmeen Koivulandia?</h2>
				<p  class="text-zinc-400">Koivulandia on <a href="fabicraft.net" target="_blank" class="text-lime-500">FabiCraftin</a> survivalissa sijaitseva kylä.</p>
			</Panel>
			<Panel>
				<h2 class="text-xl font-bold">Milloin Koivulandia Kokoontuu?</h2>
				<p class="text-zinc-400">
					Lorem, ipsum dolor sit amet consectetur adipisicing elit.
					Harum amet at, corporis facere perferendis eligendi
					voluptates? Vitae consequuntur tenetur nemo, asperiores
					saepe in, blanditiis animi totam ad eveniet, eum illum!
				</p>
			</Panel>
		</div>
	</Section>
</BaseLayout>
