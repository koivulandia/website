---
import BaseLayout from "../../layouts/BaseLayout.astro";

import Section from "../../components/layout/Section.astro";
import Container from "../../components/layout/Container.astro";

import FormattedDate from "../../components/FormattedDate.astro";
import PlayerHead from "../../components/minecraft/PlayerHead.astro";
import MinecraftUsername from "../../components/minecraft/MinecraftUsername.astro";
import Panel from "../../components/Panel.astro";
import TableOfContents from "../../components/collection/TableOfContents.astro";

import { getCollection, render } from "astro:content";
// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
    const legislations = await getCollection("legislations");
    return legislations.map((legislation) => ({
        params: { slug: legislation.id },
        props: { legislation },
    }));
}
// 2. For your template, you can get the entry directly from the prop
const { legislation } = Astro.props;
const { Content, headings } = await render(legislation);
---
<BaseLayout>
    <Section class="pt-32">
        <Container class="flex flex-col gap-16">
            <Panel>
                <h1 class="text-4xl font-bold">{legislation.data.name}</h1>
                <p>Laatinut: <PlayerHead class="w-4 inline" uuid={legislation.data.created.author} /> <MinecraftUsername uuid={legislation.data.created.author} /> <FormattedDate date={legislation.data.created.date} /></p>
                {legislation.data.updated && <p>Viimeisin muokkaus: <PlayerHead class="w-4 inline" uuid={legislation.data.updated.author} /> <MinecraftUsername uuid={legislation.data.updated.author} /> <FormattedDate date={legislation.data.updated.date} /></p>}
                {legislation.data.description && <p class="text-zinc-300 mt-2">{legislation.data.description}</p>}
            </Panel>
            <div class="flex gap-4 items-start">
                <article class="prose prose-invert prose-zinc max-w-none"><Content /></article>
                <TableOfContents headings={headings} levels={3} />
            </div>
        </Container>
    </Section>
</BaseLayout>
