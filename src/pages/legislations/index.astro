---
import BaseLayout from "../../layouts/BaseLayout.astro";

import Section from "../../components/layout/Section.astro";
import Container from "../../components/layout/Container.astro";

import Heading from "../../components/typography/Heading.astro";
import Paragraph from "../../components/typography/Paragraph.astro";

import Panel from "../../components/Panel.astro";

import { getCollection } from "astro:content";

const legislations = (await getCollection("legislations")).sort(
    (a, b) => b.data.priority - a.data.priority || b.data.created.date.valueOf() - a.data.created.date.valueOf(),
);
---
<BaseLayout>
	<Section class="pt-32">
		<Container>
			<Heading class="mb-4">Lakitekstit</Heading>
			<div class="flex flex-col gap-4">
				{legislations.map(legislation => (
					<Panel href={`/legislations/${legislation.id}/`}>
						<Heading size={2}>{legislation.data.name}</Heading>
						<Paragraph>{legislation.data.description}</Paragraph>
					</Panel>
				))}
			</div>
		</Container>
	</Section>
</BaseLayout>
