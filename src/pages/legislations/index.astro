---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import Panel from "../../components/Panel.astro";

import { getCollection } from "astro:content";

const legislations = (await getCollection("legislations")).sort(
    (a, b) => b.data.priority - a.data.priority || b.data.created.date.valueOf() - a.data.created.date.valueOf(),
);
---
<BaseLayout>
	<Section class="pt-32">
		<h1 class="text-4xl font-bold mb-4">Lakitekstit</h1>
		<div class="flex flex-col gap-4">
			{legislations.map(legislation => (
				<Panel href={`/legislations/${legislation.id}/`}>
					<h2 class="font-bold text-xl">{legislation.data.name}</h2>
					<p class="text-zinc-400">{legislation.data.description}</p>
				</Panel>
			))}
		</div>
	</Section>
</BaseLayout>
