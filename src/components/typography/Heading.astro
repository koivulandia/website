---
interface Props {
	size?: number;
    class?: string;
}

const { size = 1, class: className } = Astro.props;

const headingClasses = {
  1: "text-4xl",
  2: "text-2xl",
  3: "text-xl",
  4: "text-lg",
  5: "text-base",
  6: "text-sm",
};

const Tag = `h${size}`;
---

<Tag class:list={["font-bold mb-2", headingClasses[size], className]}>
    <slot />
</Tag>