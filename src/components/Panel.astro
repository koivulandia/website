---
interface Props {
	href?: string;
    borderColor?: string;
    class?: string;
}

const { href, borderColor, class: className } = Astro.props;
---
{href ? (
  <a style={borderColor ? `border-color: ${borderColor};` : undefined} href={href} class:list={["p-4 rounded-lg border-2 border-zinc-500 shadow-md hover:border-lime-500", className]}>
    <slot />
  </a>
) : (
  <div style={borderColor ? `border-color: ${borderColor};` : undefined} class:list={["p-4 rounded-lg border-2 border-zinc-500 shadow-md", className]}>
    <slot />
  </div>
)}
