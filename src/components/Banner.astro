---
import Section from "./Section.astro";
import backgroundImage from "../images/banner.png";
import Button from "../components/Button.astro";
---

<div style={`background-image: url('${backgroundImage.src}');`} class="banner">
    <Section class="text-center flex flex-col gap-4 items-center">
        <h1 class="font-bold text-4xl">Koivulandia</h1>
        <p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Quod, assumenda at? Ab dolore ea nulla exercitationem, aliquam explicabo unde id repellendus fugit soluta, est maiores eius laudantium iure, earum veniam.</p>
        <Button href="https://youtu.be/dQw4w9WgXcQ">Liity Koivulandiaan</Button>
    </Section>
</div>

<style>
    .banner {
        background-size: cover;
        background-position: center;
    }
</style>