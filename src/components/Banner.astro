---
import Section from "./Section.astro";
import backgroundImage from "../images/banner.png";
import Button from "../components/Button.astro";
---

<div style={`background-image: url('${backgroundImage.src}');`} class="banner">
    <Section class="text-center flex flex-col gap-4 pt-32 items-center">
        <h1 class="font-bold text-4xl">Koivulandia</h1>
        <p>
        Koivulandia on Minecraft-valtio, joka on perustettu jo vuonna 2020.
        Koivulandia toimii yhteisöhenkisellä FabiCraft-palvelimella.
        </p>
        <p>
        Tervetuloa pelaamaan mahtavaan yhteisöömme Koivulandiaan!
        </p>
        <Button href="https://discord.gg/44dPAyUT8u" target="_blank">Liity Koivulandiaan</Button>
    </Section>
</div>

<style>
    .banner {
        background-size: cover;
        background-position: center;
    }
</style>